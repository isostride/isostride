{
  "name": "strideprism",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 3000",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=reports/vitest.json",
    "check": "npm run -s test:report; npm run -s e2e; npm run -s metrics; sh radical.sh check .radical/model --report reports/vitest.json --report reports/playwright.json",
    "metrics": "sh scripts/metrics.sh",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.222.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
