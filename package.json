{
  "name": "isostride",
  "version": "0.1.0",
  "private": true,
  "description": "Isostride: the app (apps/app), the site (apps/site) and their infrastructure on AWS (infra)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @isostride/app",
    "dev:site": "npm run dev -w @isostride/site",
    "build": "npm run build -w @isostride/app && npm run build -w @isostride/site",
    "build:app": "npm run build -w @isostride/app",
    "build:site": "npm run build -w @isostride/site",
    "check": "npm run check -w @isostride/app",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
